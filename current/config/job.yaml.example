job_name: "daghe-youtube-ia-archiver"

# The unlisted or public playlist to monitor
playlist_url: "https://www.youtube.com/playlist?list=YOUR_PLAYLIST_ID"

ia_settings:
  collection: "opensource_movies"
  # S3 Keys must be in this file as IA_ACCESS_KEY and IA_SECRET_KEY
  credentials_file: "${BASE_DIR}/config/ia.env"
  # Prefix template for the Internet Archive description
  description_template: "config/description_prefix.txt"
  # Identification suffix for official IA automated tool guidance
  user_agent_suffix: "DaGhE/2.x (module=daghe-youtube-ia-archiver)"

# Wayback Machine Configuration
wayback:
  enabled: true
  user_agent: "DaGhE Automation Bot (Digital Preservation effort)"

# Professional Throttling & Hardening Configuration
timeouts:
  ia_upload:
    timeout_seconds: 600             # 10 min per request
    polling_seconds: 45              # Wait between indexing checks
    max_wait_seconds: 900            # 15 min max per item
    # Adaptive Pacing: delay = min(base + index * increment, max)
    inter_item_delay_seconds: 30     # Base delay (seconds)
    inter_item_increment_seconds: 10 # Increase per item in run (seconds)
    inter_item_max_delay_seconds: 300 # Maximum delay ceiling (seconds)
    rate_limit_backoff_seconds: 300  # Cooldown if IA throttles account or is overloaded

  wayback:
    timeout_seconds: 60              # 1 min per request
    polling_seconds: 20              # Wait between retries
    max_wait_seconds: 450            # 7.5 min max per URL

# Control toggle for the registry logic
inventory:
  enabled: true
  columns:
    - id
    - title
    - uploader
    - upload_date
    - like_count
    - ia_url

paths:
  data_dir: "${BASE_DIR}/jobs/daghe-youtube-ia-archiver/data"
  archive_file: "${BASE_DIR}/jobs/daghe-youtube-ia-archiver/data/archived_videos.txt"
  inventory_tsv: "${BASE_DIR}/jobs/daghe-youtube-ia-archiver/data/archived_inventory.tsv"
  temp_work_dir: "${BASE_DIR}/jobs/daghe-youtube-ia-archiver/data/tmp"
  telegram_helper: "${BASE_DIR}/bin/telegram-notify.sh"

yt_dlp:
  cookie_file: "${BASE_DIR}/config/cookies/daghe-youtube-search-metadata.txt"
  extra_ydl_opts:
    js_runtime: "deno"
    format: "bestvideo[format_id!*=sr]+bestaudio/best[format_id!*=sr]"
    merge_output_format: "mp4"
    subtitleslangs:
        - "en.*"
        - "it.*"
    writesubtitles: true
    write_auto_subs: false
    ignore_no_formats_error: false
    sleep_interval_requests: 2
    check_formats: true

runtime:
  # Continue on minor video errors, but Terminal Throttle will always halt the run
  continue_on_video_error: true

git:
  enabled: true
  branch: "main"
  auto_push: true
  commit_message_template: "ia-archiver: {new_count} videos archived"

telegram:
  enabled: true
  notify_on_success: true # Backward compatible notification toggle
  level_on_success: "info"
  level_on_partial: "warning"
  level_on_failure: "error"
